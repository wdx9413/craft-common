{
  "name": "craft-common-store-local",
  "version": "0.20.4",
  "description": "Versioned SQLite and Markdown local persistence with Craft-compatible paths",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codebase-shards": {
      "types": "./dist/codebase-shards.d.ts",
      "default": "./dist/codebase-shards.js"
    },
    "./content-store": {
      "types": "./dist/content-store.d.ts",
      "default": "./dist/content-store.js"
    },
    "./context-access-guard": {
      "types": "./dist/context-access-guard.d.ts",
      "default": "./dist/context-access-guard.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./sqlite-busy-timeout": {
      "types": "./dist/sqlite-busy-timeout.d.ts",
      "default": "./dist/sqlite-busy-timeout.js"
    },
    "./store-migrations": {
      "types": "./dist/store-migrations.d.ts",
      "default": "./dist/store-migrations.js"
    },
    "./store-schema": {
      "types": "./dist/store-schema.d.ts",
      "default": "./dist/store-schema.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./trace-shards": {
      "types": "./dist/trace-shards.d.ts",
      "default": "./dist/trace-shards.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=23"
  },
  "dependencies": {},
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": ">=23 <26",
    "typescript": ">=5.8 <7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft-common.git"
  },
  "homepage": "https://github.com/wdx9413/craft-common#readme",
  "bugs": {
    "url": "https://github.com/wdx9413/craft-common/issues"
  }
}
