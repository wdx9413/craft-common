{
  "name": "craft-common-log",
  "version": "0.20.4",
  "description": "Content-free telemetry, evaluation and OTLP observability SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cost-ledger": {
      "types": "./dist/cost-ledger.d.ts",
      "default": "./dist/cost-ledger.js"
    },
    "./evaluation-contract": {
      "types": "./dist/evaluation-contract.d.ts",
      "default": "./dist/evaluation-contract.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./journal-sink": {
      "types": "./dist/journal-sink.d.ts",
      "default": "./dist/journal-sink.js"
    },
    "./operation": {
      "types": "./dist/operation.d.ts",
      "default": "./dist/operation.js"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "default": "./dist/otlp.js"
    },
    "./store-sink": {
      "types": "./dist/store-sink.d.ts",
      "default": "./dist/store-sink.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=23"
  },
  "dependencies": {
    "craft-common-store-local": "workspace:*",
    "craft-common-base": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": ">=23 <26",
    "typescript": ">=5.8 <7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdx9413/craft-common.git"
  },
  "homepage": "https://github.com/wdx9413/craft-common#readme",
  "bugs": {
    "url": "https://github.com/wdx9413/craft-common/issues"
  }
}
